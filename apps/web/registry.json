{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "open-upload",
  "homepage": "https://github.com/PaulSenon/better-upload",
  "items": [
    {
      "name": "upload-dropzone",
      "type": "registry:component",
      "title": "Upload dropzone",
      "description": "Drag-and-drop zone and file picker bound to an upload endpoint. Shows accepted types and limits from your contract.",
      "dependencies": ["@open-upload/react", "lucide-react"],
      "files": [
        {
          "path": "src/components/upload/upload-dropzone.tsx",
          "type": "registry:component",
          "target": "components/upload/upload-dropzone.tsx"
        }
      ],
      "categories": ["upload", "form"],
      "docs": "Components need a typed client: createUploadClient<typeof contract>({ baseUrl: '/api/upload', contract }). See the docs: /docs/components"
    },
    {
      "name": "upload-item",
      "type": "registry:component",
      "title": "Upload item",
      "description": "One upload with progress, speed, a human status line and the actions that make sense now (pause, resume, retry, start over, select file again, cancel).",
      "dependencies": ["@open-upload/client", "@open-upload/react", "lucide-react"],
      "registryDependencies": ["button", "progress"],
      "files": [
        {
          "path": "src/components/upload/upload-item.tsx",
          "type": "registry:component",
          "target": "components/upload/upload-item.tsx"
        },
        {
          "path": "src/components/upload/format.ts",
          "type": "registry:component",
          "target": "components/upload/format.ts"
        }
