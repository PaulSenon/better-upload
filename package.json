{
  "name": "open-upload-monorepo",
  "private": true,
  "description": "Type-safe, resumable uploads and downloads to your own S3-compatible storage. Name is provisional.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @open-upload/integration-tests test:integration",
    "test:e2e": "pnpm --filter @open-upload/e2e test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:packages": "turbo run check:package --filter=./packages/*",
    "minio:up": "docker compose -f tests/docker-compose.yml up -d --wait",
    "minio:down": "docker compose -f tests/docker-compose.yml down -v",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "catalog:",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
