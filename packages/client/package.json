{
  "name": "@open-upload/client",
  "version": "0.0.0",
  "description": "Typed upload client derived from the contract: resumable multipart, adaptive concurrency, retries, persistence.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulSenon/better-upload.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hash-worker": {
      "source": "./src/hash-worker.ts",
      "types": "./dist/hash-worker.d.ts",
      "default": "./dist/hash-worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@open-upload/core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@open-upload/server": "workspace:*",
    "@types/node": "catalog:",
    "publint": "^0.3.25",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
