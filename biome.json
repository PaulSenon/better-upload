{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.output",
      "!**/.tanstack",
      "!**/.source",
      "!**/routeTree.gen.ts",
      "!**/_generated",
      "!**/public/r",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.md",
      "!**/*.mdx",
      "!apps/web/src/styles/app.css",
      "!infra/site",
      "!tooling"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off", "noConfusingVoidType": "off" },
      "complexity": { "noBannedTypes": "off" },
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" }
    }
  }
}
